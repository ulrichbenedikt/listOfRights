{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "Rechtsregeln für ERP/CRM/E-Commerce in Deutschland",
  "description": "Schema einer Regel. Datumsangaben im Format YYYY-MM-DD. Texte zweisprachig (de/en). Der Status wird aus validFrom/transitionUntil berechnet, außer statusOverride ist gesetzt.",
  "type": "object",
  "required": ["dataVersion", "lastUpdated", "rules"],
  "properties": {
    "dataVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "lastUpdated": { "$ref": "#/$defs/date" },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "i18n": {
      "type": "object",
      "required": ["de", "en"],
      "properties": { "de": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "i18nList": {
      "type": "object",
      "required": ["de", "en"],
      "properties": {
        "de": { "type": "array", "items": { "type": "string" } },
        "en": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["metric"],
      "properties": {
        "metric": { "enum": ["employees", "revenue", "balanceSheet", "profit"] },
        "min": { "type": "number", "description": "inklusive" },
        "max": { "type": "number", "description": "inklusive" }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "law", "norm", "title", "url", "jurisdiction", "categories", "summary", "softwareRequirements", "appliesTo", "validFrom", "sources", "lastVerified"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(de|eu)-[a-z0-9-]+$", "description": "Stabil, nie ändern – wird von KIs referenziert." },
        "law": { "type": "string", "description": "Kurzbezeichnung des Gesetzes, z. B. DSGVO, BGB" },
        "norm": { "type": "string", "description": "Paragraph/Artikel, z. B. § 312k" },
        "title": { "$ref": "#/$defs/i18n" },
        "url": { "type": "string", "format": "uri", "description": "Link zur Norm (deutsch)" },
        "urlEn": { "type": "string", "format": "uri", "description": "Optional: englische Fassung" },
        "jurisdiction": { "enum": ["DE", "EU"] },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Schlüssel aus taxonomy.json#categories" },
        "summary": { "$ref": "#/$defs/i18n" },
        "softwareRequirements": { "$ref": "#/$defs/i18nList", "description": "Was Software konkret leisten muss – Prüfliste für KI-Compliance-Checks" },
        "appliesTo": {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": { "$ref": "#/$defs/i18n" },
            "businessModels": { "type": "array", "items": { "enum": ["b2b", "b2c"] }, "description": "Leer/fehlend = alle" },
            "activities": { "type": "array", "items": { "type": "string" }, "description": "Mindestens eine muss zutreffen. Schlüssel aus taxonomy.json#activities. Fehlend = alle Unternehmen." },
            "thresholds": {
              "type": "object",
              "required": ["mode", "conditions"],
              "properties": {
                "mode": { "enum": ["any", "all"] },
                "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
              }
            },
            "exemptions": {
              "type": "array",
              "description": "Ausgenommen, wenn alle conditions zutreffen",
              "items": {
                "type": "object",
                "required": ["conditions", "text"],
                "properties": {
                  "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
                  "text": { "$ref": "#/$defs/i18n" }
                }
              }
            }
          }
        },
        "validFrom": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "transitionUntil": { "$ref": "#/$defs/date" },
        "statusOverride": { "enum": ["live", "transition", "planned"] },
        "stage": { "$ref": "#/$defs/i18n", "description": "Gesetzgebungsstand bei geplanten Regeln" },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "label"],
            "properties": { "date": { "$ref": "#/$defs/date" }, "label": { "$ref": "#/$defs/i18n" } }
          }
        },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
        "lastVerified": { "$ref": "#/$defs/date" },
        "reviewedBy": { "type": "string", "description": "Gesetzt, sobald ein Mensch den Eintrag fachlich geprüft hat" }
      }
    }
  }
}
